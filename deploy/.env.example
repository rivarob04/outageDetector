# Copy to deploy/.env and adjust. Every variable is optional.
# See docs/CONFIGURATION.md for the full reference.

# Public URL of this instance (used in notification links and feeds)
# PULSE_BASE_URL=https://pulse.example.com

# First-run admin account (alternatively create it in the UI setup screen)
# PULSE_ADMIN_USERNAME=admin
# PULSE_ADMIN_PASSWORD=change-me

# Allow anonymous read-only viewing of the dashboard (true/false)
# PULSE_PUBLIC_VIEW=true

# Allow custom probes to private/LAN addresses (homelab services)
# PULSE_ALLOW_PRIVATE_TARGETS=false

# Use Postgres instead of SQLite (start with --profile postgres)
# PULSE_DATABASE_URL=postgresql://pulse:pulse@postgres:5432/pulse

# MQTT / Home Assistant discovery (start with --profile mqtt)
# PULSE_MQTT_URL=mqtt://mosquitto:1883

# Host port (left side of host:container)
# PULSE_HOST_PORT=8080
# Port Pulse listens on inside the container (right side)
# PULSE_PORT=8080
